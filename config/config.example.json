{
  "listenAddress": ":8080",
  "databasePath": "/data/relay.db",
  "pollInterval": "500ms",
  "baseBackoff": "1s",
  "maxBackoff": "1m",
  "shutdownTimeout": "10s",
  "channels": [
    {
      "name": "demo",
      "targetURL": "http://receiver:9090/webhooks",
      "secretEnv": "RELAY_CHANNEL_DEMO_SECRET",
      "timeout": "3s",
      "maxAttempts": 5
    }
  ]
}
